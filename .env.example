# Шаблон переменных окружения. Скопируйте в .env.local для локальной
# разработки; на Vercel задайте эти же переменные в
# Project → Settings → Environment Variables.

# --- Доставка лидов форм в Telegram (обязательно) -----------------------
# Токен бота — от @BotFather. Только на сервере, в клиент не попадает.
TELEGRAM_BOT_TOKEN=
# Куда слать заявки: id личного чата владельца или группы менеджеров
# (бота нужно добавить в группу). Узнать id: @userinfobot.
TELEGRAM_CHAT_ID=

# --- Закрытие от индексации (staging/preview) ---------------------------
# Установите =1 на Vercel (Production), ПОКА сайт живёт на *.vercel.app
# (условие QA: staging закрыт от индекса). Уберите при переключении
# домена rapsodia.ru. Preview-деплои Vercel закрывает от индексации сам.
# NEXT_PUBLIC_NOINDEX=1
